pipeline {
    agent any

    environment {
        APP_DIR     = '/home/ubuntu/DevOps_Project'
        EC2_USER    = 'ubuntu'
        SSH_KEY_ID  = 'ec2-ssh-key'
        EC2_IP_ID   = 'ec2-ip'
        ENV_FILE_ID = 'app-env-file'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Code checked out from branch: ${env.BRANCH_NAME}"
            }
        }

        stage('Build Images') {
            // All images build from the REPO ROOT (.) so the workspace-shared
            // Go module is in the build context; the per-service Dockerfile is
            // selected with -f.
            parallel {
                stage('API') {
                    steps {
                        sh 'docker build -t docplatform-api:latest          -f api/Dockerfile .'
                    }
                }
                stage('Worker MD') {
                    steps {
                        sh 'docker build -t docplatform-worker-md:latest    -f worker-md/Dockerfile .'
                    }
                }
                stage('Worker DOCX') {
                    steps {
                        sh 'docker build -t docplatform-worker-docx:latest  -f worker-docx/Dockerfile .'
                    }
                }
                stage('Worker Thumb') {
                    steps {
                        sh 'docker build -t docplatform-worker-thumb:latest -f worker-thumb/Dockerfile .'
                    }
                }
            }
        }

        stage('Save & Transfer Images') {
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: env.SSH_KEY_ID, keyFileVariable: 'SSH_KEY'),
                    string(credentialsId: env.EC2_IP_ID, variable: 'EC2_IP'),
                    file(credentialsId: env.ENV_FILE_ID, variable: 'ENV_FILE')
                ]) {
                    sh '''
                        echo "📦 Saving images..."
                        docker save docplatform-api:latest          | gzip > api.tar.gz
                        docker save docplatform-worker-md:latest    | gzip > worker-md.tar.gz
                        docker save docplatform-worker-docx:latest  | gzip > worker-docx.tar.gz
                        docker save docplatform-worker-thumb:latest | gzip > worker-thumb.tar.gz

                        echo "🚀 Transferring images + compose + observability config to EC2..."
                        ssh -i $SSH_KEY -o StrictHostKeyChecking=no \
                            ${EC2_USER}@${EC2_IP} "mkdir -p ${APP_DIR}"
                        scp -i $SSH_KEY -o StrictHostKeyChecking=no \
                            api.tar.gz worker-md.tar.gz worker-docx.tar.gz worker-thumb.tar.gz \
                            docker-compose.yml \
                            ${EC2_USER}@${EC2_IP}:${APP_DIR}/
                        scp -i $SSH_KEY -o StrictHostKeyChecking=no -r \
                            observability \
                            ${EC2_USER}@${EC2_IP}:${APP_DIR}/

                        echo "🔧 Copying .env to EC2..."
                        ssh -i $SSH_KEY -o StrictHostKeyChecking=no \
                            ${EC2_USER}@${EC2_IP} "cat > ${APP_DIR}/.env && chmod 600 ${APP_DIR}/.env" < $ENV_FILE
                    '''
                }
            }
        }

        stage('Deploy on EC2') {
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: env.SSH_KEY_ID, keyFileVariable: 'SSH_KEY'),
                    string(credentialsId: env.EC2_IP_ID, variable: 'EC2_IP')
                ]) {
                    sh """
                        ssh -i \$SSH_KEY -o StrictHostKeyChecking=no \
                            \${EC2_USER}@\${EC2_IP} bash << 'REMOTE'
                        set -e
                        cd /home/ubuntu/DevOps_Project

                        echo "⏬ Loading new Docker images..."
                        docker load < api.tar.gz
                        docker load < worker-md.tar.gz
                        docker load < worker-docx.tar.gz
                        docker load < worker-thumb.tar.gz

                        echo "🔄 Restarting application services..."
                        docker compose stop  api worker-md worker-docx worker-thumb
                        docker compose rm -f api worker-md worker-docx worker-thumb
                        # Brings the four app services back up; depends_on also
                        # ensures prometheus is running.
                        docker compose up -d api worker-md worker-docx worker-thumb

                        echo "🧹 Cleaning up tarballs..."
                        rm -f api.tar.gz worker-md.tar.gz worker-docx.tar.gz worker-thumb.tar.gz
REMOTE
                    """
                }
            }
        }

        stage('Health Check') {
            steps {
                withCredentials([string(credentialsId: env.EC2_IP_ID, variable: 'EC2_IP')]) {
                    sh '''
                        echo "🏥 Waiting for API to come up..."
                        sleep 10
                        curl -sf http://${EC2_IP}:8080/health && \
                            echo "✅ API is healthy!" || \
                            (echo "❌ Health check failed!" && exit 1)
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'rm -f api.tar.gz worker-md.tar.gz worker-docx.tar.gz worker-thumb.tar.gz || true'
            echo "Pipeline finished: ${currentBuild.currentResult}"
        }
        success {
            echo "🎉 Deployment successful!"
        }
        failure {
            echo "🚨 Pipeline failed — check logs above"
        }
    }
}
