AWS_REGION=ap-south-1
PORT=8080

# S3 bucket + DynamoDB tables — must match your applied Terraform (project_name = "mdtopdf")
S3_BUCKET=mdtopdf-bucket-YOURNAME
DYNAMODB_TABLE=mdtopdf-jobs
TENANTS_TABLE=mdtopdf-tenants

# SQS queue URLs — replace ACCOUNT_ID with your AWS account number
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/mdtopdf-queue
DOCX_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/mdtopdf-docx-queue
THUMB_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/mdtopdf-thumb-queue
# Required for SSE push notifications — without it the API poller stays disabled
NOTIFICATION_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/mdtopdf-notification-queue

# Admin secret for POST /admin/tenants (sent as the X-Admin-Secret header)
ADMIN_SECRET=changeme

# Webhook delivery timeout in seconds (dispatcher defaults to 10 if unset)
WEBHOOK_TIMEOUT_SECONDS=10
